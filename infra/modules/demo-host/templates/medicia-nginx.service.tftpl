[Unit]
Description=MedicIA owned Nginx proxy (challenge-only until certificate activation)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
RuntimeDirectory=medicia-nginx
RuntimeDirectoryMode=0755
UMask=0027
ExecStartPre=/usr/local/libexec/medicia-proxy init
ExecStart=/usr/sbin/nginx -c /etc/medicia/nginx/active.conf -e /dev/null -g 'daemon off;'
ExecReload=/usr/sbin/nginx -t -c /etc/medicia/nginx/active.conf -e /dev/null
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutStartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/medicia/nginx /var/lib/medicia/nginx /run/medicia-nginx

[Install]
WantedBy=multi-user.target

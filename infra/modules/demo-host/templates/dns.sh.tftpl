#!/bin/bash
# Privado, sin argumentos: consume únicamente el token ya publicado por runtime.
set +x
set -Eeuo pipefail
if ! node - "$@" <<'NODE' 2>/dev/null
const fs = require('node:fs');
const { spawnSync } = require('node:child_process');
try {
  if (process.argv.length !== 2 || process.getuid() !== 0) throw new Error('identity');
  const config = JSON.parse(Buffer.from('${dns_config_base64}', 'base64').toString('utf8'));
  if (!/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.duckdns\.org$/.test(config.public_hostname)) throw new Error('hostname');
  // Abrir una sola vez fija la generación; no aceptar links de archivo ni permisos amplios.
  const fd = fs.openSync(config.token_path, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
  let token;
  try {
    const stat = fs.fstatSync(fd);
    if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o777) !== 0o600 || stat.size > 513) throw new Error('permissions');
    const contents = fs.readFileSync(fd, 'utf8');
    if (!/^[\x21-\x7e]{1,512}\n$/.test(contents)) throw new Error('token');
    token = contents.slice(0, -1);
  } finally { fs.closeSync(fd); }
  const domain = config.public_hostname.slice(0, -'.duckdns.org'.length);
  const url = 'https://www.duckdns.org/update?domains=' + domain + '&token=' + encodeURIComponent(token);
  // Sin pipeline: validar/leer primero, comprobar spawn, timeout y status antes del OK exacto.
  // -q primero ignora curlrc; proxy explícitamente vacío, CA verificada por defecto.
  const result = spawnSync('curl', ['-q', '--silent', '--fail', '--proto', '=https',
    '--proxy', '', '--noproxy', '*', '--connect-timeout', '5', '--max-time', '20', '--config', '-'], {
    input: 'url = "' + url + '"\n', encoding: 'utf8', timeout: 25000, maxBuffer: 1024,
  });
  if (result.error || result.signal || result.status !== 0 || result.stdout !== 'OK') throw new Error('update');
} catch { process.exitCode = 1; }
NODE
then
  printf 'medicia dns: rejected\n' >&2
  exit 1
fi
printf 'medicia dns: updated\n'

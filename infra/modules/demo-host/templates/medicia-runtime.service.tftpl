[Unit]
Description=MedicIA verified release and tmpfs configuration
Wants=network-online.target
After=network-online.target amazon-ssm-agent.service
Before=medicia.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/medicia-runtime
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run /opt/medicia/releases
TimeoutStartSec=180

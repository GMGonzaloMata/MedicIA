{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:e2e)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run lint)",
      "PowerShell(npm test)",
      "PowerShell(npm run test)",
      "PowerShell(npm run test:coverage)",
      "PowerShell(npm run test:e2e)",
      "PowerShell(npm run build)",
      "PowerShell(npm run check)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws *)",
      "Bash(npx prisma migrate *)",
      "Bash(npx prisma db push *)",
      "PowerShell(git push *)",
      "PowerShell(terraform apply *)",
      "PowerShell(terraform destroy *)",
      "PowerShell(aws *)",
      "PowerShell(npx prisma migrate *)",
      "PowerShell(npx prisma db push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "PowerShell(Get-Content .env*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/stop-check.mjs\"",
            "timeout": 300,
            "statusMessage": "Comprobando npm run check"
          }
        ]
      }
    ]
  }
}

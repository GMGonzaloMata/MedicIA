// Modelo de datos de acceso multi-clínica.
// Las restricciones CHECK y los índices parciales no se declaran acá: se agregan a mano
// en el SQL de la migración (ver specs/001-modelo-datos-acceso/data-model.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED

  @@map("membership_status")
}

enum PatientStatus {
  PENDING
  LINKED
  REVOKED

  @@map("patient_status")
}

enum DocumentType {
  DNI
  PASSPORT
  OTHER

  @@map("document_type")
}

// Clínica: frontera de aislamiento de todos los datos clínicos.
model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships StaffMembership[]
  patients    Patient[]
  assignments DoctorPatientAssignment[]
  studies     Study[]
  analyses    Analysis[]

  @@map("tenants")
}

// Cuenta de una persona, global a la plataforma. No guarda contraseñas ni tokens.
model User {
  id                String   @id @default(uuid(7)) @db.Uuid
  cognitoSub        String   @unique @map("cognito_sub")
  email             String   @unique
  fullName          String   @map("full_name")
  isPlatformAdmin   Boolean  @default(false) @map("is_platform_admin")
  sessionsValidFrom DateTime @default(now()) @map("sessions_valid_from") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        StaffMembership[]
  patients           Patient[]
  assignmentsCreated DoctorPatientAssignment[] @relation("AssignmentCreatedBy")
  assignmentsEnded   DoctorPatientAssignment[] @relation("AssignmentEndedBy")
  sessions           Session[]
  studiesUploaded    Study[]
  analysesRequested  Analysis[]

  @@map("users")
}

// Pertenencia de una cuenta al personal de una clínica.
model StaffMembership {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  isClinicAdmin Boolean          @default(false) @map("is_clinic_admin")
  isDoctor      Boolean          @default(false) @map("is_doctor")
  specialty     String?
  licenseNumber String?          @map("license_number")
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments DoctorPatientAssignment[]
  sessions    Session[]

  @@unique([tenantId, userId])
  @@unique([tenantId, licenseNumber])
  @@unique([tenantId, id])
  // Destino de la clave foránea compuesta de la sesión: una sesión no apunta a la membresía de otra cuenta.
  @@unique([userId, id])
  @@index([userId])
  @@map("staff_memberships")
}

// Registro de una persona dentro de una clínica. Solo guarda documento y nombre.
model Patient {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  documentType   DocumentType  @map("document_type")
  documentNumber String        @map("document_number")
  fullName       String?       @map("full_name")
  status         PatientStatus @default(PENDING)
  linkedAt       DateTime?     @map("linked_at") @db.Timestamptz(3)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User?                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments  DoctorPatientAssignment[]
  sessions     Session[]
  studies      Study[]
  studyCounter StudyCounter?

  @@unique([tenantId, documentType, documentNumber])
  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  // Destino de la clave foránea compuesta de la sesión: una sesión no apunta al paciente de otra cuenta.
  @@unique([userId, id])
  @@index([userId])
  @@map("patients")
}

// Un período de atención de un paciente por un médico. Las terminadas se conservan como historial.
model DoctorPatientAssignment {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  membershipId    String    @map("membership_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)
  endedByUserId   String?   @map("ended_by_user_id") @db.Uuid

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership StaffMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  patient    Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  createdBy  User            @relation("AssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  endedBy    User?           @relation("AssignmentEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, membershipId, patientId, createdAt])
  @@map("doctor_patient_assignments")
}

// Periodo en que una persona está dentro de la plataforma, con su propia clínica activa.
// Guarda el hash del identificador de la cookie, nunca el valor, y ningún token de Cognito.
// La clínica no se guarda: se deduce del vínculo activo. Los CHECK se agregan a mano en la migración
// (ver specs/002-ingreso-sesion/data-model.md).
model Session {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  tokenHash               String    @unique @map("token_hash")
  createdAt               DateTime  @map("created_at") @db.Timestamptz(3)
  lastActivityAt          DateTime  @map("last_activity_at") @db.Timestamptz(3)
  expiresAt               DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt               DateTime? @map("revoked_at") @db.Timestamptz(3)
  activeStaffMembershipId String?   @map("active_staff_membership_id") @db.Uuid
  activePatientId         String?   @map("active_patient_id") @db.Uuid

  user                  User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeStaffMembership StaffMembership? @relation(fields: [userId, activeStaffMembershipId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  activePatient         Patient?         @relation(fields: [userId, activePatientId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("sessions")
}

// Tipo de estudio. Hoy solo existe el electrocardiograma; el usuario lo elige de forma explícita.
enum StudyType {
  ECG

  @@map("study_type")
}

// Estado del estudio como archivo. El estado del proceso de análisis vive en cada análisis (008), no acá.
enum StudyStatus {
  UPLOADED

  @@map("study_status")
}

// Estudio de un paciente de una clínica (specs/006-carga-estudios-ecg/data-model.md). No guarda el nombre
// del archivo subido ni ninguna variable del estudio: eso vive solo en el archivo guardado en S3.
// Los CHECK (number > 0) se agregan a mano en el SQL de la migración.
model Study {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  // La cuenta que lo cargó: el propio paciente o su médico. Se toma siempre de la sesión.
  uploadedByUserId String      @map("uploaded_by_user_id") @db.Uuid
  // Correlativo dentro del paciente. Se asigna al guardar, no cambia y nunca se reutiliza.
  number           Int
  type             StudyType   @default(ECG)
  status           StudyStatus @default(UPLOADED)
  // Clave del objeto en el bucket de estudios. La arma el servidor, nunca el cliente.
  storageKey       String      @map("storage_key")
  uploadedAt       DateTime    @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Clave compuesta: un estudio no puede quedar en una clínica distinta de la de su paciente.
  patient    Patient    @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  uploadedBy User       @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  analyses   Analysis[]

  @@unique([tenantId, patientId, number])
  // Destino de la clave foránea compuesta de los análisis (008).
  @@unique([tenantId, id])
  @@unique([storageKey])
  @@index([uploadedByUserId])
  @@map("studies")
}

// Último número de estudio entregado a cada paciente. Permite asignar el número de forma atómica y que
// uno eliminado no se reutilice. Los CHECK (last_number > 0) se agregan a mano en el SQL de la migración.
model StudyCounter {
  patientId  String @id @map("patient_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  lastNumber Int    @map("last_number")

  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)

  // Prisma exige una unicidad sobre los campos de la relación uno a uno; la clave primaria ya garantiza
  // que haya una fila por paciente.
  @@unique([tenantId, patientId])
  @@map("study_counters")
}

// Estado de un análisis (constitución, principio IV). Vive en el análisis, no en el estudio.
enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("analysis_status")
}

// Por qué falló un análisis, en términos genéricos: nunca guarda el cuerpo del error del modelo.
enum AnalysisFailureCode {
  MODEL_UNAVAILABLE
  INPUT_REJECTED
  TIMEOUT
  STUDY_FILE_UNAVAILABLE
  INTERNAL

  @@map("analysis_failure_code")
}

// Una ejecución del modelo sobre un estudio (specs/008-analisis-estudio-ecg/data-model.md). Un estudio puede tener
// muchos análisis; eliminar el estudio elimina los suyos. Se agregan a mano en el SQL de la migración: el índice
// único parcial `analyses_one_in_progress` (un solo análisis en curso por estudio) y los CHECK de coherencia
// entre el estado y los demás campos.
model Analysis {
  id                String               @id @default(uuid(7)) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  studyId           String               @map("study_id") @db.Uuid
  // La cuenta que lo pidió. Se toma siempre de la sesión.
  requestedByUserId String               @map("requested_by_user_id") @db.Uuid
  status            AnalysisStatus       @default(PENDING)
  failureCode       AnalysisFailureCode? @map("failure_code")
  // El modelo y la versión que informó el contenedor en su respuesta, no los que se esperaban.
  modelName         String?              @map("model_name")
  modelVersion      String?              @map("model_version")
  // Las 12 probabilidades del contrato, validadas con zod al escribir y al leer.
  probabilities     Json?                @db.JsonB
  requestedAt       DateTime             @default(now()) @map("requested_at") @db.Timestamptz(3)
  startedAt         DateTime?            @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?            @map("finished_at") @db.Timestamptz(3)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Clave compuesta: un análisis no puede quedar en una clínica distinta de la de su estudio.
  study       Study  @relation(fields: [tenantId, studyId], references: [tenantId, id], onDelete: Cascade)
  requestedBy User   @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, studyId, requestedAt(sort: Desc)])
  @@index([requestedByUserId])
  @@map("analyses")
}

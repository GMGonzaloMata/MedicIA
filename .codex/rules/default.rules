# Comprobar con: codex execpolicy check --pretty --rules .codex/rules/default.rules -- <comando>

# Comandos con efectos externos: piden confirmación.

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Publicar cambios requiere confirmación.",
    match = ["git push origin main"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["aws"],
    decision = "prompt",
    justification = "Los comandos de AWS pueden modificar recursos.",
    match = ["aws s3 rm s3://bucket/file"],
)

# Comandos reservados: solo los ejecuta el responsable del proyecto desde su terminal.

prefix_rule(
    pattern = ["git", "commit"],
    decision = "forbidden",
    justification = "Los commits los hace solo el responsable del proyecto.",
    match = ["git commit -m mensaje"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["npx", "prisma", ["migrate", "db", "generate"]],
    decision = "forbidden",
    justification = "Los comandos de Prisma los ejecuta solo el responsable del proyecto.",
    match = ["npx prisma migrate deploy", "npx prisma db push", "npx prisma generate"],
    not_match = ["npx prisma validate"],
)

prefix_rule(
    pattern = ["prisma", ["migrate", "db", "generate"]],
    decision = "forbidden",
    justification = "Los comandos de Prisma los ejecuta solo el responsable del proyecto.",
    match = ["prisma migrate dev", "prisma db push", "prisma generate"],
    not_match = ["prisma validate"],
)

prefix_rule(
    pattern = ["terraform", ["apply", "destroy", "import", "state"]],
    decision = "forbidden",
    justification = "Los comandos de Terraform que modifican infraestructura real los ejecuta solo el responsable del proyecto.",
    match = ["terraform apply", "terraform destroy", "terraform import aws_s3_bucket.main bucket", "terraform state rm aws_s3_bucket.main"],
    not_match = ["terraform fmt", "terraform validate", "terraform init -backend=false"],
)

prefix_rule(
    pattern = ["tofu", ["apply", "destroy", "import", "state"]],
    decision = "forbidden",
    justification = "Los comandos de OpenTofu que modifican infraestructura real los ejecuta solo el responsable del proyecto.",
    match = ["tofu apply", "tofu destroy", "tofu import aws_s3_bucket.main bucket", "tofu state rm aws_s3_bucket.main"],
    not_match = ["tofu fmt", "tofu validate", "tofu init -backend=false"],
)

# Copiá este archivo como .env.local y ajustá los valores si hace falta.

# Conexión a la base de PostgreSQL local de Docker (docker-compose.yml).
# Sirve para probar la aplicación y para las pruebas de integración.
# Las pruebas vacían las tablas y se niegan a correr si el servidor no es local.
# La base de producción no se configura acá: la define el servidor.
DATABASE_URL="postgresql://medicia:medicia@localhost:5433/medicia"

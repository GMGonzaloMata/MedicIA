# Copiá este archivo como .env.local y ajustá los valores si hace falta.

# Conexión a la base de PostgreSQL local de Docker (docker-compose.yml).
# Sirve para probar la aplicación y para las pruebas de integración.
# Las pruebas vacían las tablas y se niegan a correr si el servidor no es local.
# La base de producción no se configura acá: la define el servidor.
DATABASE_URL="postgresql://medicia:medicia@localhost:5433/medicia"

 Servicio de identidad: "cognito" o "fake". Es obligatoria y no tiene valor por defecto.
# "fake" es un proveedor en memoria para desarrollar y probar sin AWS (código de verificación 000000).
# Nunca lo uses en un despliegue real: se niega a iniciar si hay variables COGNITO_* definidas.
IDENTITY_PROVIDER=fake

# Solo con IDENTITY_PROVIDER=cognito. Con "fake" deben estar ausentes.
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=